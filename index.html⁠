<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>By biw shop 💜✨ Glam & Cyber Cute</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;600;700&display=swap" rel="stylesheet">
    <!-- jsQR Library สำหรับสแกน QR Code บนสลิป -->
    <script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        glam: {
                            bg: '#0F091A',
                            card: '#1A112B',
                            border: '#3B235E',
                            purple: '#A855F7',
                            neon: '#C084FC',
                            pink: '#F472B6',
                            accent: '#EC4899'
                        }
                    },
                    fontFamily: {
                        kanit: ['Kanit', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Kanit', sans-serif;
            background-color: #0F091A;
            color: #F3E8FF;
        }
        .glow-effect {
            box-shadow: 0 0 20px rgba(168, 85, 247, 0.35);
        }
        .glow-text {
            text-shadow: 0 0 10px rgba(192, 132, 252, 0.6);
        }
    </style>
</head>
<body class="min-h-screen pb-12">

    <!-- Audio Player (The Hills - The Weeknd) -->
    <audio id="bgMusic" loop preload="auto">
        <source src="https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3" type="audio/mpeg">
    </audio>

    <!-- Header / Banner -->
    <header class="relative bg-gradient-to-r from-purple-900 via-pink-900 to-indigo-950 p-6 rounded-b-3xl border-b border-glam-border glow-effect text-center">
        <button id="musicBtn" onclick="toggleMusic()" class="absolute top-4 right-4 bg-glam-card border border-glam-purple p-3 rounded-full text-glam-neon hover:scale-110 transition shadow-lg">
            <i id="musicIcon" class="fas fa-music animate-pulse"></i>
        </button>
        <h1 class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-glam-neon via-pink-400 to-purple-300 glow-text">
            ✨ By biw shop ✨
        </h1>
        <p class="text-xs text-purple-300 mt-1">Dark Cyber Glam & Cute Store 💜</p>
        
        <!-- Bar Notice Policy -->
        <div class="mt-4 inline-block bg-pink-950/60 border border-pink-500/40 px-4 py-1.5 rounded-full text-xs text-pink-200">
            ⏰ นโยบายการเคลมสินค้า: รับประกันสิทธิ์ภายใน 5 ชั่วโมงหลังรับสินค้า
        </div>
    </header>

    <div class="max-w-md mx-auto px-4 mt-6 space-y-6">

        <!-- Banner สินค้าแนะนำ (Facebook) -->
        <section class="bg-glam-card p-5 rounded-2xl border border-glam-border glow-effect">
            <h2 class="text-lg font-bold text-glam-neon mb-3 flex items-center gap-2">
                <i class="fab fa-facebook text-blue-400"></i> สินค้าแนะนำ / เฟสบุ๊ค
            </h2>
            <div class="bg-purple-950/40 p-4 rounded-xl border border-purple-800/50 flex justify-between items-center">
                <div>
                    <h3 class="font-semibold text-white">Facebook Account Premium</h3>
                    <p class="text-xs text-purple-300">พร้อมใช้งาน สะอาด ปลอดภัย</p>
                    <span class="inline-block mt-2 text-sm font-bold text-pink-400">฿150 / ไอดี</span>
                </div>
                <button onclick="selectProduct('Facebook Account Premium', 150)" class="bg-gradient-to-r from-glam-purple to-pink-500 text-white text-xs px-4 py-2 rounded-xl font-semibold shadow-md hover:opacity-90">
                    ซื้อเลย
                </button>
            </div>
        </section>

        <!-- Payment Section -->
        <section class="bg-glam-card p-5 rounded-2xl border border-glam-border glow-effect text-center space-y-4">
            <h2 class="text-lg font-bold text-glam-neon">💳 ชำระเงิน / โอนผ่านธนาคาร</h2>
            
            <div class="bg-gradient-to-br from-green-950/60 to-emerald-900/40 p-4 rounded-xl border border-green-500/30 text-left space-y-1">
                <div class="text-xs text-green-300 font-semibold">ธนาคารกสิกรไทย (K-Bank)</div>
                <div class="text-lg font-bold text-white tracking-wider">231-3-42778-4</div>
                <div class="text-xs text-gray-300">ชื่อบัญชี: สุนิตรา มุ่งผันกลาง</div>
            </div>

            <!-- QR Slip Upload -->
            <div class="border-2 border-dashed border-glam-border p-4 rounded-xl hover:border-glam-purple transition">
                <i class="fas fa-qrcode text-3xl text-glam-neon mb-2"></i>
                <p class="text-xs text-purple-200">แนบสลิปเพื่อตรวจสอบอัตโนมัติ (jsQR)</p>
                <input type="file" id="slipInput" accept="image/*" class="hidden" onchange="verifySlip(event)">
                <button onclick="document.getElementById('slipInput').click()" class="mt-3 bg-purple-900/80 hover:bg-purple-800 text-xs px-4 py-2 rounded-lg border border-glam-purple">
                    เลือกรูปสลิปโอนเงิน
                </button>
                <div id="slipStatus" class="text-xs mt-2 font-semibold"></div>
            </div>
        </section>

        <!-- Contact Section -->
        <section class="bg-glam-card p-4 rounded-2xl border border-glam-border text-center space-y-2">
            <p class="text-xs text-gray-400">ติดปัญหาหรือสอบถามข้อมูลเพิ่มเติม</p>
            <a href="https://line.me/ti/p/~@282ppxul" target="_blank" class="inline-flex items-center gap-2 bg-green-600 text-white text-xs px-5 py-2.5 rounded-xl font-semibold shadow-lg hover:bg-green-500">
                <i class="fab fa-line text-lg"></i> ติดต่อทีมงาน Line: @282ppxul
            </a>
        </section>

        <!-- Admin Portal Access -->
        <section class="text-center pt-4">
            <button onclick="openAdminModal()" class="text-xs text-purple-400/60 hover:text-purple-300 underline">
                🔐 เข้าสู่ระบบผู้ดูแลระบบ (Admin)
            </button>
        </section>

    </div>

    <!-- Script Logic -->
    <script>
        // Music Player Toggle
        const bgMusic = document.getElementById('bgMusic');
        const musicIcon = document.getElementById('musicIcon');
        let isPlaying = false;

        function toggleMusic() {
            if (isPlaying) {
                bgMusic.pause();
                musicIcon.classList.remove('fa-spin');
            } else {
                bgMusic.play().catch(() => {});
                musicIcon.classList.add('fa-spin');
            }
            isPlaying = !isPlaying;
        }

        // Select Product
        function selectProduct(name, price) {
            alert(`คุณเลือกซื้อ: ${name}\nราคา: ฿${price}\nกรุณาโอนเงินมาที่บัญชี K-Bank แล้วแนบสลิปด้านล่างค่ะ`);
        }

        // Verify Slip with jsQR
        function verifySlip(event) {
            const file = event.target.files[0];
            const statusDiv = document.getElementById('slipStatus');
            if (!file) return;

            statusDiv.className = "text-xs mt-2 font-semibold text-yellow-400";
            statusDiv.innerText = "กำลังตรวจสอบสลิป...";

            const reader = new FileReader();
            reader.onload = function(e) {
                const img = new Image();
                img.onload = function() {
                    const canvas = document.createElement('canvas');
                    const ctx = canvas.getContext('2d');
                    canvas.width = img.width;
                    canvas.height = img.height;
                    ctx.drawImage(img, 0, 0, img.width, img.height);
                    const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
                    const code = jsQR(imageData.data, imageData.width, imageData.height);

                    if (code) {
                        statusDiv.className = "text-xs mt-2 font-semibold text-green-400";
                        statusDiv.innerText = "✅ ตรวจสอบสลิปสำเร็จ! ทำรายการเรียบร้อย";
                    } else {
                        statusDiv.className = "text-xs mt-2 font-semibold text-pink-400";
                        statusDiv.innerText = "⚠️ แนบสลิปเรียบร้อยแล้ว (รอเจ้าหน้าที่ตรวจสอบเพิ่มเติม)";
                    }
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        // Admin Portal Login
        function openAdminModal() {
            const password = prompt("กรุณากรอกรหัสผ่าน Admin:");
            if (password === "1234") {
                alert("🔓 เข้าสู่ระบบ Admin สำเร็จ!\nยินดีต้อนรับสู่ระบบจัดการหลังบ้าน By biw shop");
            } else if (password !== null) {
                alert("❌ รหัสผ่านไม่ถูกต้อง");
            }
        }
    </script>
</body>
</html>
